# Base da API consumida pelo site (raiz SEM a versao).
# Entra no bundle do cliente em build time (Vite inlines VITE_*).
VITE_API_BASE_URL=https://gatumsgourmet.com.br

# Versao da API (anexada como /api/<versao>). Default: v1.
# Separada da base para permitir versionar sem reconfigurar a raiz.
VITE_API_VERSION=v1
