# Modelo para criar o seu .env.local (que e ignorado pelo git).
# Copie este arquivo para ".env.local" e ajuste se necessario:
#   cp .env.local.example .env.local   (Linux/macOS)
#   Copy-Item .env.local.example .env.local   (Windows PowerShell)
#
# VITE_API_BASE_URL e a RAIZ da API, SEM a versao. O config.ts anexa /api/v1.
# API local sobe em http://localhost:5166.
VITE_API_BASE_URL=http://localhost:5166
VITE_API_VERSION=v1
