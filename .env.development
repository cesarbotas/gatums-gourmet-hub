# Ambiente de desenvolvimento do front.
#
# VITE_API_BASE_URL deve ser a RAIZ da API, SEM a versao.
# O config.ts anexa automaticamente o sufixo "/api/${VITE_API_VERSION}" (ex.: /api/v1).
# Portanto NAO inclua "/api/v1" aqui.
#
# Rodando o front JUNTO da API local (os 2 projetos na mesma maquina):
# a API sobe em http://localhost:5166 e o front compoe http://localhost:5166/api/v1.
VITE_API_BASE_URL=http://localhost:5166
VITE_API_VERSION=v1

# IMPORTANTE: VITE_* e lido SO no boot do Vite. Ao mudar este arquivo,
# PARE (Ctrl+C) e rode `npm run dev` de novo — recarregar a pagina nao basta.
#
# --- Outras formas de apontar a base (editar a linha ativa acima) ---
# Producao:  https://gatumsgourmet.com.br
# API em OUTRA maquina da rede: http://<IP-da-maquina-da-API>:5166
#   (a versao /api/v1 e anexada automaticamente pelo config.ts)
