# Ambiente de desenvolvimento do front.
#
# VITE_API_BASE_URL deve ser a RAIZ da API, SEM a versao.
# O config.ts anexa automaticamente o sufixo "/api/${VITE_API_VERSION}" (ex.: /api/v1).
# Portanto NAO inclua "/api/v1" aqui.
#
# Rodando o front JUNTO da API local (os 2 projetos na mesma maquina):
# a API sobe em http://localhost:5166 e o front compoe http://localhost:5166/api/v1.
VITE_API_BASE_URL=http://localhost:5166
VITE_API_VERSION=v1

# --- Outras formas de apontar a base ---
# Produção:
# VITE_API_BASE_URL=https://gatumsgourmet.com.br
#
# API rodando em OUTRA maquina da rede local (rodar os 2 projetos juntos):
# defina VITE_API_BASE_URL=http://<IP-da-maquina-da-API>:5166
# A versao continua sendo anexada automaticamente pelo config.ts como /api/v1.
# Exemplo (descomente e ajuste o IP na maquina de teste):
# VITE_API_BASE_URL=http://192.168.0.10:5166
