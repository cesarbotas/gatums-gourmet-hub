# Ambiente de desenvolvimento do front.
#
# VITE_API_BASE_URL deve ser a RAIZ da API, SEM a versao.
# O config.ts anexa automaticamente o sufixo "/api/${VITE_API_VERSION}" (ex.: /api/v1).
# Portanto NAO inclua "/api/v1" aqui.
#
# Default valido (API de producao) — nao quebra quem roda o front sem API local:
VITE_API_BASE_URL=https://gatumsgourmet.com.br
VITE_API_VERSION=v1

# --- Teste contra a API rodando em OUTRA maquina da rede local ---
# Para apontar o front para a API de outra maquina (rodar os 2 projetos juntos),
# defina VITE_API_BASE_URL=http://<IP-da-maquina-da-API>:<porta>
# A versao continua sendo anexada automaticamente pelo config.ts como /api/v1.
#
# Exemplo (descomente e ajuste o IP/porta na maquina de teste):
# VITE_API_BASE_URL=http://192.168.0.10:8080
